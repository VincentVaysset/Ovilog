 "saisie_mises_bas": "\n      <div style=\"display:flex;justify-content:center;margin-bottom:16px;\">\n        <div class=\"session-counter sc-amber\"><svg viewBox=\"0 0 48 48\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n  <ellipse cx=\"22\" cy=\"27\" rx=\"13\" ry=\"10\" fill=\"currentColor\"></ellipse>\n  <circle cx=\"11\" cy=\"21\" r=\"4\" fill=\"currentColor\"></circle>\n  <circle cx=\"16\" cy=\"15\" r=\"4\" fill=\"currentColor\"></circle>\n  <circle cx=\"23\" cy=\"13\" r=\"4\" fill=\"currentColor\"></circle>\n  <circle cx=\"30\" cy=\"15\" r=\"4\" fill=\"currentColor\"></circle>\n  <circle cx=\"35\" cy=\"21\" r=\"4\" fill=\"currentColor\"></circle>\n  <ellipse cx=\"36\" cy=\"29\" rx=\"5.5\" ry=\"4.5\" fill=\"currentColor\"></ellipse>\n  <circle cx=\"38.5\" cy=\"27.5\" r=\"1.3\" fill=\"var(--card)\"></circle>\n  <rect x=\"15\" y=\"34\" width=\"3\" height=\"7\" rx=\"1.5\" fill=\"currentColor\"></rect>\n  <rect x=\"27\" y=\"34\" width=\"3\" height=\"7\" rx=\"1.5\" fill=\"currentColor\"></rect>\n</svg>0 mise bas saisie</div>\n      </div>\n      <div class=\"card\">\n        <label>Scanner la brebis qui vient de mettre bas</label>\n        <input type=\"text\" id=\"scan-misebas\" placeholder=\"Scanner ou saisir l'EID\" autofocus=\"\">\n      </div>\n      \n      \n      \n      \n      \n      \n      <div class=\"card\">\n        <div style=\"font-size:14px;font-weight:600;margin-bottom:10px;\">Mises bas de la campagne (3)</div>\n        <div style=\"overflow-x:auto;\">\n          <table class=\"\" style=\"width:100%;font-size:12.5px;border-collapse:collapse;white-space:nowrap;\">\n            <tbody><tr style=\"color:var(--text-muted);text-align:left;\">\n              <th style=\"padding:4px 4px;font-weight:500;\">N° court</th>\n              <th style=\"padding:4px 4px;font-weight:500;\">Date</th>\n              <th style=\"padding:4px 4px;font-weight:500;text-align:center;\">Mâles</th>\n              <th style=\"padding:4px 4px;font-weight:500;text-al