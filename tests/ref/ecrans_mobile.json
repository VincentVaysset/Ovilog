 "incoherences_sans_controle": "<div class=\"tab-bar bc-onglets\"><button type=\"button\" class=\"tab-btn active\" data-tab=\"incoherences\">À régulariser</button><button type=\"button\" class=\"tab-btn\" data-tab=\"reproduction\">Reproduction</button><button type=\"button\" class=\"tab-btn\" data-tab=\"economique\">Économique</button><button type=\"button\" class=\"tab-btn\" data-tab=\"lactation\">Lactation</button></div><div id=\"pc-regulariser\" class=\"bc-page\">\n    <div class=\"reg-sous\">Ce qui reste à vérifier ou à corriger avant la clôture de la campagne.</div>\n    \n    <div class=\"card bc-avance\">\n      <div class=\"bc-avance-t\"><b>Avancement</b><span>3 sur 6 renseignées</span></div>\n      <div class=\"bc-barre\" role=\"img\" aria-label=\"Ont mis bas 3, vides définitives 0, à régulariser 3\">\n        <div style=\"flex:3;background:var(--ch-vert);\"></div><div style=\"flex:0;background:var(--ch-bleu);\"></div><div style=\"flex:3;background:var(--ch-ambre);\"></div>\n      </div>\n    </div>\n    <div class=\"reg-tuiles bc-tuiles\">\n      <div class=\"reg-tuile ambre\"><div class=\"reg-tuile-l\">À régulariser</div><div class=\"reg-tuile-v\">3</div><div class=\"reg-tuile-s\">50,0 %</div></div>\n      <div class=\"reg-tuile vert\"><div class=\"reg-tuile-l\">Ont mis bas</div><div class=\"reg-tuile-v\">3</div><div class=\"reg-tuile-s\">50,0 %</div></div>\n      <div class=\"reg-tuile bleu\"><div class=\"reg-tuile-l\">Vides définitives</div><div class=\"reg-tuile-v\">0</div><div class=\"reg-tuile-s\">0,0 %</div></div>\n      <div class=\"reg-tuile gris\"><div class=\"reg-tuile-l\">Brebis présentes</div><div class=\"reg-tuile-v\">6</div><div class=\"reg-tuile-s\">actives en campagne</div></div>\n    </div>\n    <div class=\"card bc-carte\" id=\"pc-carte-a-regulariser\">\n      <div class=\"bc-tete\"><span class=\"bc-titre\">À régulariser</span><span class=\"reg-pastille ambre\">3 brebis</span></div>\n      <div class=\"reg-info\">Ni mise bas, ni vide définitive. Une échographie seule ne suffit pas.</div>\n      <div class=\"bc-filtres\">\n        <input type=\"text\" id=\"pc-reg-recherche\" placeholder=\"Rechercher un n°\" inputmode=\"numeric\" autocomplete=\"off\">\n        <select id=\"pc-reg-age\"><option value=\"\">Tous âges</option><option value=\"3\">3 ans</option><option value=\"0\">0 an</option></select>\n      </div>\n      <div id=\"pc-reg-liste\"><div class=\"bc-li bilan-eid-link\" role=\"button\" tabindex=\"0\" data-id=\"f250016299930001\" data-num=\"30001\" data-eid=\"250016299930001\" data-age=\"3\"><span class=\"bc-li-n\">n°30001</span><span class=\"bc-li-a\">3 ans</span><svg class=\"bc-chev\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 6l6 6-6 6\"></path></svg></div><div class=\"bc-li bilan-eid-link\" role=\"button\" tabindex=\"0\" data-id=\"f250016299930002\" data-num=\"30002\" data-eid=\"250016299930002\" data-age=\"3\"><span class=\"bc-li-n\">n°30002</span><span class=\"bc-li-a\">3 ans</span><svg class=\"bc-chev\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 6l6 6-6 6\"></path></svg></div><div class=\"bc-li bilan-eid-link\" role=\"button\" tabindex=\"0\" data-id=\"f250016299960002\" data-num=\"60002\" data-eid=\"250016299960002\" data-age=\"0\"><span class=\"bc-li-n\">n°60002</span><span class=\"bc-li-a\">0 an</span><svg class=\"bc-chev\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 6l6 6-6 6\"></path></svg></div></div>\n      <div class=\"reg-info\" id=\"pc-reg-aucune\" style=\"display:none;padding:8px 0 14px;\">Aucune brebis ne correspond.</div>\n      \n    </div