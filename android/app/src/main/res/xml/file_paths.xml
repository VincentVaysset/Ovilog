<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
    <!-- Correctif audit "Changement de campagne" (point 1) : les sauvegardes
         automatiques (voir BACKUP_AUTO_DIRECTORY dans www/index.html)
         vivent sous Directory.EXTERNAL (getExternalFilesDir, app-scoped,
         jamais Directory.Documents, cassé sur Android 10+ par le
         stockage cloisonné). external-files-path est le tag FileProvider
         correspondant à ce dossier précis, sans lui Share.share() lève
         "Failed to find configured root" pour tout fichier qui s'y trouve. -->
    <external-files-path name="ovilog_backups" path="." />
</paths>