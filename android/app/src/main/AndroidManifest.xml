<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Export du registre en .xlsx vers Directory.Documents (@capacitor/filesystem) :
         requis uniquement sur Android 10 et antérieur — à partir d'Android 11
         le stockage scopé rend ces permissions obsolètes pour ce dossier. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Lecteur Allflex en Bluetooth Classic/SPP (bluetooth-serial). Deux
         usages bien distincts, avec des permissions différentes :
         - Se connecter à un lecteur déjà enregistré, ou lister les
           appareils déjà appairés (écran de diagnostic, tap court du bouton
           d'en-tête) : aucune découverte, donc aucune localisation —
           BLUETOOTH_CONNECT (demandée à l'exécution) suffit sur Android
           12+ ; en dessous, BLUETOOTH/BLUETOOTH_ADMIN suffisent et sont de
           simples permissions d'installation.
         - "Changer de lecteur" (appui long sur le bouton d'en-tête, voir
           ouvrirChangerLecteur/lecteurEnsureScanPermissions) lance une
           VRAIE découverte d'appareils à proximité (discoverUnpaired) :
           ça a longtemps manqué ici (ajouté après coup, sans mettre à jour
           ce manifeste en même temps : le plugin échouait alors avec
           "Missing the following permissions in AndroidManifest.xml" dès
           qu'on appuyait sur "Relancer la recherche", peu importe combien
           de fois). BLUETOOTH_SCAN (Android 12+) et ACCESS_FINE_LOCATION
           (requise pour la découverte classic sur toutes les versions,
           demandée explicitement par lecteurEnsureScanPermissions) sont
           donc nécessaires en plus, ci-dessous. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
