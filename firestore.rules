rules_version = '2';

// Chaque utilisateur authentifié ne peut lire/écrire que ses propres
// données, sous /users/{son-uid}/... — personne d'autre n'a accès, même
// avec un autre compte Firebase valide.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
