rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logisol() {
      return request.auth != null && request.auth.uid in ['c22m7xgcZvgjMGJkLEN8hCxDLSk1'];
    }

    // Ovilog : chaque compte vérifié ne voit que ses propres données
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    // Ovilog, bulle de contact : un compte connecté écrit ses messages (adresse vérifiée non exigée pour ce seul envoi) et ne lit que les siens ;
    // l'administrateur (document admins/<uid> créé à la main dans la console) lit, répond, change le statut et supprime.
    function contactConnecte() { return request.auth != null; }
    function contactAdmin() { return contactConnecte() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow get: if contactConnecte() && request.auth.uid == uid;
      // aucune écriture depuis l'appli : la console seulement
    }

    match /feedback/{id} {
      allow create: if contactConnecte()
        && id.matches(request.auth.uid + '_.+')
        && request.resource.data.keys().hasOnly(['uid', 'exploitation', 'texte', 'type', 'date', 'dateServeur', 'campagne', 'ecran', 'version', 'appareil', 'statut', 'reponse', 'reponseDate', 'reponseLue'])
        && request.resource.data.keys().hasAll(['uid', 'texte', 'type', 'date', 'statut'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texte is string
        && request.resource.data.texte.size() > 0 && request.resource.data.texte.size() <= 2000
        && request.resource.data.type in ['bug', 'question', 'idee']
        && request.resource.data.statut == 'nouveau'
        && request.resource.data.get('reponse', '') == ''
        && request.resource.data.get('dateServeur', request.time) == request.time;
      allow read: if contactAdmin() || (contactConnecte() && resource.data.uid == request.auth.uid);
      allow update: if (contactAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'reponse', 'reponseDate', 'reponseLue'])
          && request.resource.data.statut in ['nouveau', 'lu', 'traite']
          && request.resource.data.reponse is string && request.resource.data.reponse.size() <= 2000)
        || (contactConnecte() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reponseLue'])
          && request.resource.data.reponseLue == true);
      allow delete: if contactAdmin();
    }

    // Logisol : collections réservées au propriétaire
    match /campagnes/{document=**} { allow read, write: if logisol(); }
    match /produits/{document=**} { allow read, write: if logisol(); }
    match /mouvements_stock/{document=**} { allow read, write: if logisol(); }
    match /rotations_plans/{document=**} { allow read, write: if logisol(); }
    match /rotations_revisions/{document=**} { allow read, write: if logisol(); }
    match /stades_physiologiques_config/{document=**} { allow read, write: if logisol(); }
    match /affectations_stade/{document=**} { allow read, write: if logisol(); }
    match /plans_alimentation/{document=**} { allow read, write: if logisol(); }
    match /distributions_alimentation/{document=**} { allow read, write: if logisol(); }
    match /interventions_config/{document=**} { allow read, write: if logisol(); }
    match /parcelles/{document=**} { allow read, write: if logisol(); }
    match /parcelles_config/{document=**} { allow read, write: if logisol(); }
    match /cultures_config/{document=**} { allow read, write: if logisol(); }
    match /implantations/{document=**} { allow read, write: if logisol(); }
    match /assolements/{document=**} { allow read, write: if logisol(); }
    match /interventions/{document=**} { allow read, write: if logisol(); }
    match /interventions_types/{document=**} { allow read, write: if logisol(); }
    match /stocks/{document=**} { allow read, write: if logisol(); }
    match /stades_config/{document=**} { allow read, write: if logisol(); }
    match /lots_animaux/{document=**} { allow read, write: if logisol(); }
    match /prelevements/{document=**} { allow read, write: if logisol(); }

    // Joker : toute collection « lgs_* »
    match /{col}/{document=**} {
      allow read, write: if col.matches('lgs_.*') && logisol();
    }

    // Tout le reste est refusé par défaut.
  }
}
