rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logisol() {
      return request.auth != null && request.auth.uid in ['c22m7xgcZvgjMGJkLEN8hCxDLSk1'];
    }

    // Ovilog : chaque compte vérifié ne voit que ses propres données
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    // Logisol : collections réservées au propriétaire
    match /campagnes/{document=**} { allow read, write: if logisol(); }
    match /produits/{document=**} { allow read, write: if logisol(); }
    match /mouvements_stock/{document=**} { allow read, write: if logisol(); }
    match /rotations_plans/{document=**} { allow read, write: if logisol(); }
    match /rotations_revisions/{document=**} { allow read, write: if logisol(); }
    match /stades_physiologiques_config/{document=**} { allow read, write: if logisol(); }
    match /affectations_stade/{document=**} { allow read, write: if logisol(); }
    match /plans_alimentation/{document=**} { allow read, write: if logisol(); }
    match /distributions_alimentation/{document=**} { allow read, write: if logisol(); }
    match /interventions_config/{document=**} { allow read, write: if logisol(); }
    match /parcelles/{document=**} { allow read, write: if logisol(); }
    match /parcelles_config/{document=**} { allow read, write: if logisol(); }
    match /cultures_config/{document=**} { allow read, write: if logisol(); }
    match /implantations/{document=**} { allow read, write: if logisol(); }
    match /assolements/{document=**} { allow read, write: if logisol(); }
    match /interventions/{document=**} { allow read, write: if logisol(); }
    match /interventions_types/{document=**} { allow read, write: if logisol(); }
    match /stocks/{document=**} { allow read, write: if logisol(); }
    match /stades_config/{document=**} { allow read, write: if logisol(); }
    match /lots_animaux/{document=**} { allow read, write: if logisol(); }
    match /prelevements/{document=**} { allow read, write: if logisol(); }

    // Joker : toute collection « lgs_* »
    match /{col}/{document=**} {
      allow read, write: if col.matches('lgs_.*') && logisol();
    }

    // Tout le reste est refusé par défaut.
  }
}
