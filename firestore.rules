rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Ovilog : chaque compte vérifié lit et écrit ses propres données ; l'ADMINISTRATEUR (document admins/<uid>, adresse vérifiée) peut les LIRE
    // (aperçu et sauvegarde avant une conversion), jamais les écrire.
    function proprietaireVerifie(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true; }
    function adminVerifie() { return request.auth != null && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // Verrou de version : dès que verrous/<uid> existe, toute écriture du compte doit réécrire DANS LA MÊME REQUÊTE le jeton users/<uid>/ecritures/jeton
    // avec l'heure du serveur (vEcrit == request.time) et un n° de version de l'appli au moins égal à la version minimale. Un appareil d'avant ce code
    // n'écrit pas de jeton : il est refusé (suppressions comprises). Sans verrou : rien ne change.
    function cheminVerrou(uid) { return /databases/$(database)/documents/verrous/$(uid); }
    function cheminJeton(uid) { return /databases/$(database)/documents/users/$(uid)/ecritures/jeton; }
    function jetonValide(uid, min) {
      let j = getAfter(cheminJeton(uid)).data;
      return j.get('vEcrit', null) == request.time && j.get('vApp', 0) is int && j.get('vApp', 0) >= min;
    }
    function versionAdmise(uid) { return !exists(cheminVerrou(uid)) || jetonValide(uid, get(cheminVerrou(uid)).data.get('versionMinimale', 0)); }
    match /users/{uid} {
      allow read: if proprietaireVerifie(uid) || adminVerifie();
      allow write: if proprietaireVerifie(uid);
    }
    match /users/{uid}/{collection}/{reste=**} {
      allow read: if proprietaireVerifie(uid) || adminVerifie();
      // les réglages administrateur du compte (chantiers en test) ne s'écrivent pas par cette règle
      allow write: if proprietaireVerifie(uid) && collection != 'reglagesAdmin' && versionAdmise(uid);
    }
    // Réglages administrateur du compte (interrupteur « Notification EDE ») : lus par le propriétaire, écrits seulement si le compte est administrateur (admins/<uid>)
    match /users/{uid}/reglagesAdmin/{id} {
      allow write: if proprietaireVerifie(uid) && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Verrous de version : écrits par l'administrateur SEUL (depuis son compte), lus par le compte concerné ; version minimale entière, jamais abaissée ;
    // jamais supprimés depuis l'appli (la console seulement).
    match /verrous/{uid} {
      allow get: if proprietaireVerifie(uid) || adminVerifie();
      allow list: if adminVerifie();
      allow create, update: if adminVerifie()
        && request.resource.data.keys().hasOnly(['versionMinimale', 'activeLe', 'conversion'])
        && request.resource.data.versionMinimale is int && request.resource.data.versionMinimale > 0
        && request.resource.data.versionMinimale >= (resource == null ? 0 : resource.data.get('versionMinimale', 0));
    }
    // Registre des comptes : nom de l'exploitation, versions des appareils, résultat de la conversion — AUCUNE donnée d'animal ; écrit par le compte
    // lui-même, lu (liste) et supprimé par l'administrateur.
    match /comptes/{uid} {
      allow get: if proprietaireVerifie(uid) || adminVerifie();
      allow list: if adminVerifie();
      allow create, update: if proprietaireVerifie(uid)
        && request.resource.data.keys().hasOnly(['exploitation', 'appareils', 'conversion'])
        && request.resource.data.get('exploitation', '') is string && request.resource.data.get('exploitation', '').size() <= 120
        && request.resource.data.get('appareils', {}) is map && request.resource.data.get('appareils', {}).size() <= 20;
      allow delete: if adminVerifie();
    }

    // Ovilog, bulle de contact : un compte connecté écrit ses messages (adresse vérifiée non exigée pour ce seul envoi) et ne lit que les siens ;
    // l'administrateur (document admins/<uid> créé à la main dans la console) lit, répond, change le statut et supprime.
    function contactConnecte() { return request.auth != null; }
    function contactAdmin() { return contactConnecte() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow get: if contactConnecte() && request.auth.uid == uid;
      // aucune écriture depuis l'appli : la console seulement
    }

    match /feedback/{id} {
      allow create: if contactConnecte()
        && id.matches(request.auth.uid + '_.+')
        && request.resource.data.keys().hasOnly(['uid', 'exploitation', 'texte', 'type', 'date', 'dateServeur', 'campagne', 'ecran', 'version', 'appareil', 'statut', 'reponse', 'reponseDate', 'reponseLue'])
        && request.resource.data.keys().hasAll(['uid', 'texte', 'type', 'date', 'statut'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texte is string
        && request.resource.data.texte.size() > 0 && request.resource.data.texte.size() <= 2000
        && request.resource.data.type in ['bug', 'question', 'idee']
        && request.resource.data.statut == 'nouveau'
        && request.resource.data.get('reponse', '') == ''
        && request.resource.data.get('dateServeur', request.time) == request.time;
      allow read: if contactAdmin() || (contactConnecte() && resource.data.uid == request.auth.uid);
      allow update: if (contactAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'reponse', 'reponseDate', 'reponseLue'])
          && request.resource.data.statut in ['nouveau', 'lu', 'traite']
          && request.resource.data.reponse is string && request.resource.data.reponse.size() <= 2000)
        || (contactConnecte() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reponseLue'])
          && request.resource.data.reponseLue == true);
      allow delete: if contactAdmin();
    }

    // Ovilog, rapports d'erreurs automatiques : un compte connecté écrit un rapport DÉJÀ nettoyé par l'appli (ni texte saisi, ni n°), pour son uid,
    // liste fermée de champs, chacun typé et borné ; jamais modifié (aucun update) ; l'administrateur lit et supprime.
    function ligneDePileValide(p, i) { return p.size() <= i || (p[i] is string && p[i].size() <= 200); }
    function pileValide(p) {
      return p is list && p.size() <= 5
        && ligneDePileValide(p, 0) && ligneDePileValide(p, 1) && ligneDePileValide(p, 2) && ligneDePileValide(p, 3) && ligneDePileValide(p, 4);
    }
    match /erreurs/{id} {
      allow create: if contactConnecte()
        && id.matches(request.auth.uid + '_.+')
        && request.resource.data.keys().hasOnly(['uid', 'date', 'version', 'appareil', 'ecran', 'type', 'message', 'pile', 'nombre'])
        && request.resource.data.keys().hasAll(['uid', 'date', 'version', 'appareil', 'ecran', 'type', 'message', 'pile', 'nombre'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string && request.resource.data.date.size() <= 30
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.appareil in ['android', 'pc']
        && request.resource.data.ecran is string && request.resource.data.ecran.size() <= 60
        && request.resource.data.type is string && request.resource.data.type.size() > 0 && request.resource.data.type.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && pileValide(request.resource.data.pile)
        && request.resource.data.nombre is int && request.resource.data.nombre >= 1 && request.resource.data.nombre <= 1000;
      allow read, delete: if contactAdmin();
      // aucune modification (update) : un rapport ne change jamais
    }

    // Tout le reste est refusé par défaut (Logisol a son propre projet Firebase depuis le 25/10/2026 : plus aucune de ses collections ici).
  }
}
